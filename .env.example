# ─────────────────────────────────────────────────────────────────────────────
# TerraSentinel-Nepal — Required Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET
S3_DATA_BUCKET=terrasentinel-data-dev
S3_MODEL_BUCKET=terrasentinel-models-dev
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/TerraSentinelSageMakerRole

# ── API Gateway ───────────────────────────────────────────────────────────────
API_BASE_URL=https://REPLACE.execute-api.ap-south-1.amazonaws.com/dev

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.REPLACE_WITH_MAPBOX_PUBLIC_TOKEN
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}
NEXT_PUBLIC_DATA_MODE=demo       # demo | live

# ── Geospatial Processing ─────────────────────────────────────────────────────
GDAL_DATA=/usr/share/gdal
PROJ_LIB=/usr/share/proj
FLOOD_THRESHOLD_NDWI=0.3        # NDWI threshold for water classification (0–1)
DEM_RESOLUTION_M=30             # DEM resolution in metres

# ── Risk Scoring ──────────────────────────────────────────────────────────────
RISK_MODEL_VERSION=v1
RISK_HIGH_THRESHOLD=0.7
RISK_MEDIUM_THRESHOLD=0.4

# ── Alert Dispatcher ─────────────────────────────────────────────────────────
ALERT_MODE=mock                  # mock | live  —  NEVER set live without sign-off
VOICE_LANGUAGE=ne-NP             # Nepali BCP-47 language tag
# AWS_POLLY_VOICE_ID=REPLACE     # Uncomment when live Polly is enabled

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
